{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@stalker/api",
    "watchPatterns": [
      "apps/api/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "npm run prisma:migrate --workspace=@stalker/api",
    "startCommand": "npm run start --workspace=@stalker/api",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
