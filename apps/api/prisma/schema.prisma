generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  industry       String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  clients             Client[]
  users               User[]
  salesRequests       SalesRequest[]
  creditRequests      CreditRequest[]
  transactions        Transaction[]
  suppliers           Supplier[]
  operationalAccounts OperationalAccount[]
  paymentRequests     PaymentRequest[]
  replenishments      Replenishment[]
  paymentExceptions   PaymentException[]

  @@index([name])
  @@map("organizations")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole       @default(FINANCE)
  department     String?
  organizationId String         @map("organization_id")
  paymentRecords  PaymentRecord[]
  isActive       Boolean        @default(true) @map("is_active")
  lastLoginAt    DateTime?      @map("last_login_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  followUps           FollowUp[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  organization        Organization   @relation(fields: [organizationId], references: [id])

  salesRequests         SalesRequest[]
  creditRequestsCreated CreditRequest[]       @relation("CreditCreatedBy")
  creditDecisions       CreditRequest[]       @relation("CreditDecisionBy")
  transactionsCreated   Transaction[]
  transactionApprovals  TransactionApproval[]

  paymentRequestsCreated  PaymentRequest[]   @relation("PaymentCreatedBy")
  paymentRequestsApproved PaymentRequest[]   @relation("PaymentApprovedBy")
  replenishmentsRequested Replenishment[]    @relation("ReplenishmentRequestedBy")
  replenishmentDecisions  Replenishment[]    @relation("ReplenishmentDecisionBy")
  paymentExceptionsResolved PaymentException[]

  @@index([email])
  @@index([organizationId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id                     String         @id @default(cuid())
  organizationId         String         @map("organization_id")
  name                   String
  companyRegistration    String?        @unique @map("company_registration")
  email                  String?
  phone                  String?
  sector                 String?
  creditLimit            Decimal        @default(0) @map("credit_limit") @db.Decimal(15, 2)
  slaDays                Int            @default(30) @map("sla_days")
  paymentDisciplineIndex Decimal        @default(100) @map("payment_discipline_index") @db.Decimal(5, 2)
  riskStatus             ClientRisk     @default(RELIABLE) @map("risk_status")
  isBlocked              Boolean        @default(false) @map("is_blocked")
  blockedReason          String?        @map("blocked_reason")
  notes                  String?
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  organization           Organization   @relation(fields: [organizationId], references: [id])
  invoices               Invoice[]
  slaViolations          SlaViolation[]
  salesRequests          SalesRequest[]
  creditRequests         CreditRequest[]
  transactions           Transaction[]
  // Payment Control (Phase 2) has no direct Client relation; suppliers/accounts are org-scoped.

  @@index([organizationId])
  @@index([riskStatus])
  @@index([paymentDisciplineIndex])
  @@index([isBlocked])
  @@map("clients")
}

model Invoice {
  id            String         @id @default(cuid())
  clientId      String         @map("client_id")
  invoiceNumber String         @unique @map("invoice_number")
  invoiceAmount Decimal        @map("invoice_amount") @db.Decimal(15, 2)
  invoiceDate   DateTime       @map("invoice_date")
  dueDate       DateTime       @map("due_date")
  status        InvoiceStatus  @default(PENDING)
  paidDate      DateTime?      @map("paid_date")
  paidAmount    Decimal?       @map("paid_amount") @db.Decimal(15, 2)
  amountPaid    Decimal        @default(0)  @map("amount_paid")      @db.Decimal(15, 2)
  remainingBalance Decimal?              @map("remaining_balance")  @db.Decimal(15, 2)
  payments         PaymentRecord[]
  currency      String         @default("NGN")
  notes         String?
  alertsSent    Json           @default("[]") @map("alerts_sent")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  alerts        Alert[]
  followUps     FollowUp[]
  client        Client         @relation(fields: [clientId], references: [id])
  slaViolations SlaViolation[]
  transaction   Transaction?

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
  @@index([status, dueDate])
  @@map("invoices")
}

model PaymentRecord {
  id          String    @id @default(cuid())
  invoiceId   String    @map("invoice_id")
  paidBy      String?   @map("paid_by")
  amount      Decimal   @db.Decimal(15, 2)
  paymentDate DateTime  @default(now()) @map("payment_date")
  notes       String?
  isReverted  Boolean   @default(false) @map("is_reverted")
  revertedAt  DateTime? @map("reverted_at")
  revertedBy  String?   @map("reverted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user     User?   @relation(fields: [paidBy],    references: [id])

  @@index([invoiceId])
  @@index([paidBy])
  @@index([isReverted])
  @@map("payment_records")
}

model FollowUp {
  id               String       @id @default(cuid())
  invoiceId        String       @map("invoice_id")
  userId           String       @map("user_id")
  followUpDate     DateTime     @default(now()) @map("follow_up_date")
  followUpType     FollowUpType @map("follow_up_type")
  notes            String?
  responseReceived Boolean      @default(false) @map("response_received")
  nextFollowUpDate DateTime?    @map("next_follow_up_date")
  createdAt        DateTime     @default(now()) @map("created_at")
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([userId])
  @@index([followUpDate])
  @@map("follow_ups")
}

model SlaViolation {
  id            String    @id @default(cuid())
  clientId      String    @map("client_id")
  invoiceId     String    @map("invoice_id")
  violationDate DateTime  @default(now()) @map("violation_date")
  daysLate      Int       @map("days_late")
  resolved      Boolean   @default(false)
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  client        Client    @relation(fields: [clientId], references: [id])
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@index([invoiceId])
  @@index([violationDate])
  @@map("sla_violations")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Alert {
  id        String    @id @default(cuid())
  invoiceId String    @map("invoice_id")
  alertType AlertType @map("alert_type")
  channel   String    @default("dashboard")
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  sentAt    DateTime  @default(now()) @map("sent_at")
  readAt    DateTime? @map("read_at")
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([isRead])
  @@index([alertType])
  @@map("alerts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

enum UserRole {
  ADMIN
  CFO
  FINANCE
  SALES
}

enum ClientRisk {
  RELIABLE
  MODERATE
  HIGH_RISK
  CHRONIC
}

enum InvoiceStatus {
  PENDING
  DUE_TODAY
  OVERDUE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FollowUpType {
  EMAIL
  PHONE
  IN_PERSON
  LETTER
  WHATSAPP
  ESCALATION
}

enum AlertType {
  DUE_7_DAYS
  DUE_3_DAYS
  DUE_1_DAY
  DUE_TODAY
  OVERDUE
  FOLLOW_UP_STALE
  PDI_THRESHOLD
  CREDIT_LIMIT_BREACH
}

enum EmailProvider {
  POSTMARK
  RESEND
}

enum EmailDeliveryStatus {
  SENT
  FAILED
  FALLBACK_SENT
  FALLBACK_FAILED
}

model EmailLog {
  id                String              @id @default(cuid())
  jobName           String              @map("job_name")
  recipient         String
  subject           String
  provider          EmailProvider
  status            EmailDeliveryStatus
  providerMessageId String?             @map("provider_message_id")
  errorMessage      String?             @map("error_message")
  idempotencyKey    String?             @unique @map("idempotency_key")
  usedFallback      Boolean             @default(false) @map("used_fallback")
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([recipient])
  @@index([jobName])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIAL CONTROL CHAIN — Sales → Credit → Transaction Control (Phase 1)
// ─────────────────────────────────────────────────────────────────────────────

enum SalesRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum CreditRequestStatus {
  PENDING
  APPROVED
  DECLINED
  ON_HOLD
  EXPIRED
}

enum TransactionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DECLINED
  ON_HOLD
  CANCELLED
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  PARTIALLY_PAID
}

enum FulfilmentStatus {
  PENDING
  PROCESSING
  FULFILLED
  PARTIALLY_FULFILLED
  FAILED
}

enum ApprovalDecision {
  APPROVED
  DECLINED
  ON_HOLD
}

/// Lite upstream Sales Request — origin of the control chain.
model SalesRequest {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  reference       String             @unique
  clientId        String             @map("client_id")
  title           String
  description     String?
  requestedAmount Decimal            @map("requested_amount") @db.Decimal(15, 2)
  currency        String             @default("NGN")
  status          SalesRequestStatus @default(DRAFT)
  createdById     String?            @map("created_by_id")
  submittedAt     DateTime?          @map("submitted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  client          Client             @relation(fields: [clientId], references: [id])
  createdBy       User?              @relation(fields: [createdById], references: [id])
  creditRequests  CreditRequest[]
  transactions    Transaction[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("sales_requests")
}

/// Lite Credit Control assessment for an approved sales request.
model CreditRequest {
  id              String              @id @default(cuid())
  organizationId  String              @map("organization_id")
  reference       String              @unique
  salesRequestId  String?             @map("sales_request_id")
  clientId        String              @map("client_id")
  requestedAmount Decimal             @map("requested_amount") @db.Decimal(15, 2)
  approvedAmount  Decimal?            @map("approved_amount")  @db.Decimal(15, 2)
  currency        String              @default("NGN")
  status          CreditRequestStatus @default(PENDING)
  comments        String?
  decisionById    String?             @map("decision_by_id")
  decisionAt      DateTime?           @map("decision_at")
  createdById     String?             @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [organizationId], references: [id])
  client          Client              @relation(fields: [clientId], references: [id])
  salesRequest    SalesRequest?       @relation(fields: [salesRequestId], references: [id])
  decisionBy      User?               @relation("CreditDecisionBy", fields: [decisionById], references: [id])
  createdBy       User?               @relation("CreditCreatedBy",  fields: [createdById], references: [id])
  transactions    Transaction[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("credit_requests")
}

/// Transaction Control — operational bridge between Credit Control and Payment Control.
model Transaction {
  id                      String                    @id @default(cuid())
  organizationId          String                    @map("organization_id")
  reference               String                    @unique
  srfNumber               String?                   @unique @map("srf_number")
  transactionDate         DateTime                  @default(now()) @map("transaction_date")

  clientId                String                    @map("client_id")
  clientCode              String?                   @map("client_code")
  salesRequestId          String?                   @map("sales_request_id")
  creditRequestId         String?                   @map("credit_request_id")
  invoiceId               String?                   @unique @map("invoice_id")

  // ── Financial details ──
  newTransactionValue     Decimal                   @map("new_transaction_value")     @db.Decimal(15, 2)
  supplierCost            Decimal                   @default(0) @map("supplier_cost")  @db.Decimal(15, 2)
  grossMargin             Decimal                   @default(0) @map("gross_margin")   @db.Decimal(15, 2)
  profitPercentage        Decimal                   @default(0) @map("profit_percentage") @db.Decimal(6, 2)
  currency                String                    @default("NGN")

  // ── Exposure snapshot (computed at create/refresh) ──
  creditLimit             Decimal                   @default(0) @map("credit_limit")               @db.Decimal(15, 2)
  currentExposure         Decimal                   @default(0) @map("current_exposure")           @db.Decimal(15, 2)
  postTransactionExposure Decimal                   @default(0) @map("post_transaction_exposure")  @db.Decimal(15, 2)
  availableCredit         Decimal                   @default(0) @map("available_credit")           @db.Decimal(15, 2)
  exceedsLimit            Boolean                   @default(false) @map("exceeds_limit")
  clientEligible          Boolean                   @default(true)  @map("client_eligible")

  // ── Payment verification ──
  clientPaymentStatus     PaymentVerificationStatus @default(PENDING) @map("client_payment_status")
  paymentVerified         Boolean                   @default(false)   @map("payment_verified")
  paymentSource           String?                   @map("payment_source")
  paymentDate             DateTime?                 @map("payment_date")

  // ── Approval workflow ──
  status                  TransactionStatus         @default(DRAFT)
  approvalLevel           Int                       @default(0) @map("approval_level")
  requiredApprovalLevel   Int                       @default(1) @map("required_approval_level")
  currentApproverRole     UserRole?                 @map("current_approver_role")
  approvalComments        String?                   @map("approval_comments")

  // ── Service fulfilment ──
  fulfilmentStatus        FulfilmentStatus          @default(PENDING) @map("fulfilment_status")

  createdById             String?                   @map("created_by_id")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  organization            Organization              @relation(fields: [organizationId], references: [id])
  client                  Client                    @relation(fields: [clientId], references: [id])
  salesRequest            SalesRequest?             @relation(fields: [salesRequestId], references: [id])
  creditRequest           CreditRequest?            @relation(fields: [creditRequestId], references: [id])
  createdBy               User?                     @relation(fields: [createdById], references: [id])
  invoice                 Invoice?                  @relation(fields: [invoiceId], references: [id])
  approvals               TransactionApproval[]
  paymentRequests         PaymentRequest[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([fulfilmentStatus])
  @@index([transactionDate])
  @@map("transactions")
}

/// Immutable approval-history entry for a transaction (multi-level workflow).
model TransactionApproval {
  id            String           @id @default(cuid())
  transactionId String           @map("transaction_id")
  level         Int
  decision      ApprovalDecision
  approverId    String?          @map("approver_id")
  approverRole  UserRole?        @map("approver_role")
  comments      String?
  createdAt     DateTime         @default(now()) @map("created_at")

  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approver      User?            @relation(fields: [approverId], references: [id])

  @@index([transactionId])
  @@map("transaction_approvals")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENT CONTROL (Phase 2) — Supplier disbursement after transaction approval
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

enum ReplenishmentStatus {
  PENDING
  APPROVED
  FUNDED
  DECLINED
}

enum PaymentExceptionType {
  PAYMENT_MISMATCH
  DUPLICATE_PAYMENT
  MISSING_CONFIRMATION
  OVERPAYMENT
  UNDERPAYMENT
  CURRENCY_MISMATCH
}

enum PaymentExceptionStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Supplier master — the disbursement counterparty for payment requests.
model Supplier {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String
  code              String?  @unique
  email             String?
  phone             String?
  bankName          String?  @map("bank_name")
  bankAccountNumber String?  @map("bank_account_number")
  bankAccountName   String?  @map("bank_account_name")
  isActive          Boolean  @default(true) @map("is_active")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization      Organization     @relation(fields: [organizationId], references: [id])
  paymentRequests   PaymentRequest[]

  @@index([organizationId])
  @@index([isActive])
  @@map("suppliers")
}

/// Operational (disbursement) bank account with a live running balance.
model OperationalAccount {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  accountNumber  String   @map("account_number")
  bankName       String   @map("bank_name")
  currency       String   @default("NGN")
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(18, 2)
  minimumBalance Decimal  @default(0) @map("minimum_balance") @db.Decimal(18, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  paymentRequests PaymentRequest[]
  replenishments  Replenishment[]

  @@index([organizationId])
  @@index([isActive])
  @@map("operational_accounts")
}

/// Disbursement request against an approved transaction, paid to a supplier.
model PaymentRequest {
  id                   String               @id @default(cuid())
  organizationId       String               @map("organization_id")
  reference            String               @unique
  transactionId        String               @map("transaction_id")
  supplierId           String               @map("supplier_id")
  operationalAccountId String?              @map("operational_account_id")
  requestedAmount      Decimal              @map("requested_amount") @db.Decimal(18, 2)
  currency             String               @default("NGN")
  status               PaymentRequestStatus @default(DRAFT)

  // Balance validation snapshot
  accountBalanceAtRequest Decimal? @map("account_balance_at_request") @db.Decimal(18, 2)
  replenishmentRequired   Boolean  @default(false) @map("replenishment_required")

  // Processing / confirmation
  paymentAmount         Decimal?       @map("payment_amount") @db.Decimal(18, 2)
  paymentDate           DateTime?      @map("payment_date")
  paymentMethod         PaymentMethod? @map("payment_method")
  confirmationReference String?        @map("confirmation_reference")
  confirmedAt           DateTime?      @map("confirmed_at")
  dueDate               DateTime?      @map("due_date")

  // Approval
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  approvalComments String?   @map("approval_comments")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  transaction        Transaction         @relation(fields: [transactionId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  operationalAccount OperationalAccount? @relation(fields: [operationalAccountId], references: [id])
  approvedBy         User?               @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  createdBy          User?               @relation("PaymentCreatedBy",  fields: [createdById], references: [id])
  exceptions         PaymentException[]

  @@index([organizationId])
  @@index([transactionId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@map("payment_requests")
}

/// Funding top-up for an operational account that fell below what payments need.
model Replenishment {
  id                   String              @id @default(cuid())
  organizationId       String              @map("organization_id")
  reference            String              @unique
  operationalAccountId String              @map("operational_account_id")
  requiredAmount       Decimal             @map("required_amount")  @db.Decimal(18, 2)
  requestedAmount      Decimal             @map("requested_amount") @db.Decimal(18, 2)
  approvedAmount       Decimal?            @map("approved_amount")  @db.Decimal(18, 2)
  status               ReplenishmentStatus @default(PENDING)
  notes                String?
  requestedById        String?             @map("requested_by_id")
  decisionById         String?             @map("decision_by_id")
  decisionAt           DateTime?           @map("decision_at")
  fundedAt             DateTime?           @map("funded_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id])
  operationalAccount OperationalAccount @relation(fields: [operationalAccountId], references: [id])
  requestedBy        User?              @relation("ReplenishmentRequestedBy", fields: [requestedById], references: [id])
  decisionBy         User?              @relation("ReplenishmentDecisionBy",  fields: [decisionById], references: [id])

  @@index([organizationId])
  @@index([operationalAccountId])
  @@index([status])
  @@map("replenishments")
}

/// Auto-detected anomaly on a payment request (mismatch, duplicate, etc.).
model PaymentException {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  paymentRequestId String?                @map("payment_request_id")
  type             PaymentExceptionType
  status           PaymentExceptionStatus @default(OPEN)
  detail           String?
  resolvedById     String?                @map("resolved_by_id")
  resolvedAt       DateTime?              @map("resolved_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  resolvedBy     User?           @relation(fields: [resolvedById], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@map("payment_exceptions")
}
